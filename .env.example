# Opscend configuration. Copy to .env (gitignored) and adjust.
#   cp .env.example .env
# Both the API (api/) and docker-compose read this file.

# ── Security ────────────────────────────────────────────────────────────────
# Encrypts provider tokens at rest and signs session cookies. REQUIRED outside
# local development. Generate one with:
#   python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# If empty, the API generates a development key in api/.opscend_secret_key and warns.
OPSCEND_SECRET_KEY=

# The single login. Change both before exposing Opscend to a network.
OPSCEND_ADMIN_EMAIL=admin@opscend.local
OPSCEND_ADMIN_PASSWORD=opscend-dev

# Session lifetime in hours, and whether the cookie requires HTTPS (set 1 behind TLS).
OPSCEND_SESSION_HOURS=168
OPSCEND_COOKIE_SECURE=0

# ── Storage and jobs ────────────────────────────────────────────────────────
# SQLite by default (zero infrastructure). docker-compose overrides this with
# postgresql+asyncpg://opscend:opscend@postgres:5432/opscend
DATABASE_URL=sqlite+aiosqlite:///./opscend.db

# Leave empty to run jobs inline inside the API process. Set it (docker-compose
# does: redis://redis:6379) to use the arq worker instead.
REDIS_URL=

# Run Alembic migrations when the API starts.
OPSCEND_AUTO_MIGRATE=1
# Inline mode only: run the periodic poll / health-check jobs in the API process.
OPSCEND_BACKGROUND_JOBS=1
# Seconds between provider polls and between health checks (minimum 30).
OPSCEND_POLL_INTERVAL_SECONDS=60
OPSCEND_HEALTH_INTERVAL_SECONDS=60
# Days to keep stored log lines and health checks (pruned hourly). 0 keeps everything.
OPSCEND_RETENTION_DAYS=30

# ── Demo mode ───────────────────────────────────────────────────────────────
# Seeds a fictional storefront (3 integrations, ~40 deploys, incidents, one finished
# investigation) on first start and enables POST /api/demo/break and /api/demo/reset.
OPSCEND_DEMO=1
# Webhook secret of the demo integrations, so you can try signed webhooks with curl.
OPSCEND_DEMO_WEBHOOK_SECRET=opscend-demo-webhook

# ── Public demo (hosting a showcase for strangers) ──────────────────────────
# 1 = open to anyone without a login, sample data only. Connecting, testing, syncing
# and deleting integrations, webhooks, health-URL edits and test emails are refused;
# investigations and chat are answered by a script (no model, no key, no cost); each
# visitor sees only their own chats; the sample data is rebuilt when it goes quiet.
# Leave 0 on your own install. Set OPSCEND_COOKIE_SECURE=1 with it when behind HTTPS,
# and build the web app with OPSCEND_PUBLIC_DEMO=1 too ("Try the live demo" button).
OPSCEND_PUBLIC_DEMO=0
# Minutes after which quiet sample data is rebuilt (0 = never).
OPSCEND_PUBLIC_DEMO_REFRESH_MINUTES=120
# 1 = simulate the model on your own demo install as well (to try the tour without a key).
OPSCEND_AI_SIMULATED=0

# ── AI investigator ─────────────────────────────────────────────────────────
# Bring your own key: https://console.groq.com/keys. Without it everything works
# except starting an investigation (the API answers 409 with a hint).
GROQ_API_KEY=
# Any tool-calling model your key can use (list them: GET $OPSCEND_AI_BASE_URL/models).
OPSCEND_AI_MODEL=openai/gpt-oss-120b
# Any OpenAI-compatible endpoint works; GROQ_API_KEY is sent as the bearer token.
OPSCEND_AI_BASE_URL=https://api.groq.com/openai/v1
# Label shown in the UI.
OPSCEND_AI_PROVIDER=groq
# Hard limits per investigation and per chat answer.
OPSCEND_AI_MAX_TOOL_CALLS=8
OPSCEND_AI_TOKEN_BUDGET=40000
# Investigate a failed deploy as soon as its incident opens (needs GROQ_API_KEY).
# The limit counts all investigations of the last 24 hours, so a run of failures
# cannot use up your LLM quota.
OPSCEND_AUTO_INVESTIGATE=1
OPSCEND_AUTO_INVESTIGATE_DAILY_LIMIT=20

# ── Web (read by the Next.js app) ───────────────────────────────────────────
# Where the web app proxies /api/* to.
OPSCEND_API_URL=http://127.0.0.1:8000

# ── Email alerts (optional) ──────────────────────────────────────────────────
# Notifications always show in the console. Set these to also get them by email.
# Any SMTP provider works (Gmail app password, Resend, SES, Mailgun, Postmark...).
OPSCEND_SMTP_HOST=
OPSCEND_SMTP_PORT=587
OPSCEND_SMTP_USERNAME=
OPSCEND_SMTP_PASSWORD=
# starttls (port 587), ssl (port 465) or none (local test servers only)
OPSCEND_SMTP_SECURITY=starttls
# Defaults to OPSCEND_SMTP_USERNAME when empty.
OPSCEND_EMAIL_FROM=
OPSCEND_EMAIL_TO=
# Which events are emailed. All kinds: incident_opened, incident_resolved,
# investigation_completed, investigation_failed, integration_error
OPSCEND_EMAIL_EVENTS=incident_opened,investigation_completed,integration_error
# Where the console is reachable; used for links inside emails.
OPSCEND_PUBLIC_URL=http://localhost:3000
